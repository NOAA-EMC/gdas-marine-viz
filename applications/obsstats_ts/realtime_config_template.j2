# Configuration for depth and ocean basin binning of in-situ observations
# Generated from Jinja2 template - simplifies multi-experiment setup
# Basin codes: 1=Atlantic, 2=Pacific, 3=Indian, 4=Arctic, 5=Southern

{# Macro to ensure directory exists - creates directories during template generation #}
{% macro ensure_dir_exists(path) -%}
  {%- set ns = namespace() -%}
  {%- set ns.result = "" -%}
  {%- if path.startswith('./') -%}
    {%- set ns.result = path[2:] -%}
  {%- else -%}
    {%- set ns.result = path -%}
  {%- endif -%}
  {%- if ns.result and ns.result != "." -%}
    {{- "import os; os.makedirs('" + ns.result + "', exist_ok=True)" -}}
  {%- endif -%}
{%- endmacro %}

