{% set ocean_basins = [
    {'name': 'Global', 'codes': None, 'suffix': 'global'},
    {'name': 'Atlantic', 'codes': [1], 'suffix': 'atlantic'},
    {'name': 'Pacific', 'codes': [2], 'suffix': 'pacific'},
    {'name': 'Indian', 'codes': [3], 'suffix': 'indian'},
    {'name': 'Arctic', 'codes': [4], 'suffix': 'arctic'},
    {'name': 'Southern', 'codes': [5], 'suffix': 'southern'}
] %}

{% set default_config = {
    'varname': 'temp',
    'geovar_group': 'ombg',
    'time_interval': 21600,
    'ice_edge_stats': false
} %}

{% set date_pattern = date_wildcard | default('2025*') %}

# NOTE: Directories will be created automatically by plot_timeseries.py

experiments:
{% for exp in experiments %}
  "{{ exp.name }}":
    observation_spaces:
{% for platform in insitu_platforms %}
{% for basin in ocean_basins %}
      - name: "{{ platform.name }} - {{ basin.name }}"
        ioda_data_path: "./{{ exp.data_dir }}/gdas.{{ date_pattern }}/*/analysis/ocean/diags/{{ platform.file_pattern }}"
        varname: "{{ platform.varname | default(default_config.varname) }}"
        geovar_group: "{{ platform.geovar_group | default(default_config.geovar_group) }}"
        time_interval: {{ default_config.time_interval }}
        ice_edge_stats: {{ default_config.ice_edge_stats | lower }}
        stats_output: "./{{ exp.output_dir }}/{{ platform.safe_name }}_{{ basin.suffix }}_{{ platform.geovar_group | default(default_config.geovar_group) }}_statistics.nc"
{% if basin.codes %}
        ocean_basins: {{ basin.codes }}
{% endif %}
{% if platform.depth_min is defined and platform.depth_max is defined %}
        depth_bins: [[{{ platform.depth_min }}, {{ platform.depth_max }}]]
{% endif %}
{% endfor %}
{% endfor %}

{% for platform in sst_platforms %}
{% for basin in ocean_basins %}
      - name: "{{ platform.name }} - {{ basin.name }}"
        ioda_data_path: "./{{ exp.data_dir }}/gdas.{{ date_pattern }}/*/analysis/ocean/diags/{{ platform.file_pattern }}"
        varname: "{{ default_config.varname }}"
        geovar_group: "{{ default_config.geovar_group }}"
        time_interval: {{ default_config.time_interval }}
        ice_edge_stats: {{ default_config.ice_edge_stats | lower }}
        stats_output: "./{{ exp.output_dir }}/{{ platform.safe_name }}_{{ basin.suffix }}_{{ default_config.geovar_group }}_statistics.nc"
{% if basin.codes %}
        ocean_basins: {{ basin.codes }}
{% endif %}
{% endfor %}
{% endfor %}

{% for platform in icec_platforms %}
{% for basin in ocean_basins %}
      - name: "{{ platform.name }} - {{ basin.name }}"
        ioda_data_path: "./{{ exp.data_dir }}/gdas.{{ date_pattern }}/*/analysis/ocean/diags/{{ platform.file_pattern }}"
        varname: "{{ platform.varname }}"
        geovar_group: "{{ platform.geovar_group }}"
        time_interval: {{ default_config.time_interval }}
        ice_edge_stats: {{ default_config.ice_edge_stats | lower }}
        stats_output: "./{{ exp.output_dir }}/{{ platform.safe_name }}_{{ basin.suffix }}_{{ platform.geovar_group }}_statistics.nc"
{% if basin.codes %}
        ocean_basins: {{ basin.codes }}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}

output_dir: "{{ output_base_dir | default('./stats-comparisons') }}"
title: "{{ config_title | default('Observation Statistics') }}"

# Template variables that can be customized:
# - output_base_dir: Base directory for plots (default: './real-time')
# - config_title: Title for the configuration (default: auto-generated)
# - date_wildcard: Date pattern for data paths (default: '2025*', supports YYYYMMDD with wildcards)
#
# This template automatically generates observation spaces for:
# - All in-situ platforms across all ocean basins (Global, Atlantic, Pacific, Indian, Arctic, Southern):
#   * Surface Drifters (Temperature)
#   * Argo Profiles Temperature in 3 depth bins: [0-10m], [0-300m], [300-2000m]
#   * Argo Profiles Salinity in 3 depth bins: [0-10m], [0-300m], [300-2000m]
#   * Altimeter ADT observations: Jason-3, Sentinel-3A, Sentinel-6A, SWOT, Cryosat-2
# - All SST satellite platforms across all ocean basins (Global, Atlantic, Pacific, Indian, Arctic, Southern)
# - All ice concentration platforms across all ocean basins (Global, Atlantic, Pacific, Indian, Arctic, Southern):
#   * AMSR2 Ice Concentration North
#   * AMSR2 Ice Concentration South
#
# Each observation space is configured with basin-specific filtering where applicable:
# - Basin codes: 1=Atlantic, 2=Pacific, 3=Indian, 4=Arctic, 5=Southern
# - Global observations have no basin filtering (ocean_basins parameter omitted)
#
# Usage examples:
# 1. Generate with default settings: python generate_config.py -o config.yaml
# 2. Custom output directory: python generate_config.py -o config.yaml --output-dir './my_analysis'
# 3. Custom title: python generate_config.py -o config.yaml --title 'My Marine Analysis'
# 4. Different date pattern: python generate_config.py -o config.yaml --date-wildcard '2024*'
